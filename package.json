{
  "name": "@tetherto/miningos-wrk-ork",
  "version": "1.1.0",
  "description": "MiningOS Ork Worker",
  "main": "worker.js",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/miningos-wrk-ork.git"
  },
  "homepage": "https://github.com/tetherto/miningos-wrk-ork#readme",
  "bugs": {
    "url": "https://github.com/tetherto/miningos-wrk-ork/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "worker.js",
    "workers/"
  ],
  "type": "commonjs",
  "bin": {
    "miningos-wrk-ork": "worker.js"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.js",
    "test:coverage": "brittle --coverage tests/unit/*.js tests/integration/*.js",
    "dev": "node worker.js --wtype wrk-ork-proc-aggr --env development --cluster shard-1"
  },
  "dependencies": {
    "@bitfinex/bfx-facs-interval": "^1.0.0",
    "@bitfinex/bfx-svc-boot-js": "1.3.1",
    "@bitfinex/lib-js-util-base": "^2.1.0",
    "@bitfinex/lib-js-util-task-queue": "^1.0.1",
    "@tetherto/miningos-lib-stats": "git+https://github.com/tetherto/miningos-lib-stats.git#v1.0.0",
    "@tetherto/svc-facs-action-approver": "^1.0.2",
    "@tetherto/tether-wrk-base": "^2.0.1",
    "async": "3.2.6",
    "date-fns": "3.6.0",
    "debug": "4.4.1",
    "mingo": "6.4.6"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  }
}
